{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeekWars Local",
  "version": "0.2.2",
  "identifier": "com.steodec.leekwarslocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LeekWars Local",
        "width": 1360,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/leekwars-server"
    ],
    "shortDescription": "Gestion et analyse des combats Leek Wars",
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2N0IwMTJFNkFEODQ2OTcKUldTWFJ0aHFMZ0Y3WmtlK0lwSjRPTnpySUZLQlZITnJLSDhIWm8wdVpFWjdMWjBNd0s0YUdxVGcK",
      "endpoints": [
        "https://github.com/steodec/LeekWarsLocal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
